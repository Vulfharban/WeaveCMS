# WeaveCMS – Plugins Directory Protection
# Erlaubt statische Assets (CSS, JS, Bilder, Schriftarten),
# verhindert aber das direkte unautorisierte Ausführen von internen Skripten.

Options -Indexes

<FilesMatch "(?i)\.(css|js|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

# Manifest-Dateien schützen
<Files "plugin.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>
