# ==============================================================================
# Sicherheits- und Server-Konfiguration: WeaveCMS
# Schutz sensibler Dateien vor direktem HTTP-Abruf & Verzeichnis-Schutz
# ==============================================================================

# 1. Verzeichnis-Auflistung deaktivieren (Directory Browsing sperren)
Options -Indexes

# 2. Direkten HTTP-Zugriff auf Konfigurationsdateien, Systemdateien & Daten sperren
#    (PHP-Skripte auf dem Server können lokal weiterhin uneingeschränkt lesen & schreiben)
<FilesMatch "(^config.*\.php$|data\.json|installed\.lock|deploy_projects\.json|composer\.(json|lock)|.*\.(json|lock|sql|sqlite|db|md|log|bak|env|ini|yml|yaml)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Direkten Zugriff auf versteckte Dateien und Ordner (.git, .htaccess, .agents etc.) sperren
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Schutz von internen Ordnern vor direktem Web-Aufruf
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Sperrt den direkten Web-Zugriff auf Backups, Rohdaten, PHP-Bibliotheken, Template-Views und Logs
    RewriteRule ^(backups|data|views|admin/views|libs/php|libs/docs|logs)/ - [F,L]
</IfModule>
